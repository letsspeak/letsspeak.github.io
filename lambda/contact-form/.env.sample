# AWS Lambda環境変数設定ファイル
# 実際の値に変更してからデプロイしてください

# AWS Region (default: ap-northeast-1)
AWS_REGION=ap-northeast-1

# SES送信元メールアドレス (事前にSESで検証済みであること)
FROM_EMAIL=contact@lsklab.com

# 受信先メールアドレス (お問い合わせを受け取るメールアドレス)
TO_EMAIL=contact@lsklab.com

# Lambda関数名
LAMBDA_FUNCTION_NAME=contact-form-handler

# API Gateway設定 (オプション)
API_GATEWAY_NAME=contact-form-api
API_GATEWAY_STAGE=prod